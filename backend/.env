# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cleanic_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long_for_security
JWT_EXPIRE=7d

# SMS Service (Twilio) - Development mode will use console logging
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email Service - Development mode will use console logging
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_email_password

# Cloudinary (for image uploads) - Optional
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Optional)
# PAYFAST_MERCHANT_ID=your_payfast_merchant_id
# PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
# PAYFAST_PASSPHRASE=your_payfast_passphrase

# App Configuration
APP_NAME=Cleanic
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Default Test Verification Code
DEFAULT_VERIFICATION_CODE=1234